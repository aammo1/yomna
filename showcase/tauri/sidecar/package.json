{
  "name": "jarvis-sidekick",
  "description": "The Jarvis agent: a Node sidecar for the Jarvis desktop app (based on Roamies)",
  "private": true,
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/EricTechPro/jarvis.git",
    "directory": "showcase/tauri/sidecar"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "./bundle.sh",
    "test": "node test/run.mjs",
    "test:live": "node bench/memory.mjs",
    "coverage": "c8 --all --src . --exclude \"test/**\" --exclude \"bench/**\" --exclude \"node_modules/**\" --exclude \"beats/**\" --exclude \"dist/**\" --reporter=text-summary --reporter=json-summary node test/run.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.321",
    "@google/genai": "3.6.1",
    "@kenkaiiii/gg-agent": "5.108.0",
    "@kenkaiiii/gg-ai": "5.108.0",
    "@kenkaiiii/gg-core": "5.108.0",
    "@kenkaiiii/ggcoder": "5.108.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "c8": "12.0.0",
    "esbuild": "0.28.2"
  },
  "overrides": {
    "undici": "7.30.1",
    "@huggingface/transformers": "4.3.2",
    "@anthropic-ai/sandbox-runtime": { "zod": "$zod" }
  }
}
