{
  "name": "yomna-sidecar",
  "description": "The Yomna agent: a Node sidecar for the Yomna desktop app",
  "private": true,
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/aammo1/yomna.git",
    "directory": "showcase/tauri/sidecar"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "./bundle.sh",
    "test": "node test/run.mjs",
    "test:live": "node bench/memory.mjs",
    "coverage": "c8 --all --src . --exclude \"test/**\" --exclude \"bench/**\" --exclude \"node_modules/**\" --exclude \"beats/**\" --exclude \"dist/**\" --reporter=text-summary --reporter=json-summary node test/run.mjs"
  },
  "dependencies": {
    "@google/genai": "3.6.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "c8": "12.0.0",
    "esbuild": "0.28.2"
  },
  "overrides": {
    "undici": "7.30.1",
    "@huggingface/transformers": "4.3.2"
  }
}
